BD_DRIVER=ODBC Driver 17 for SQL Server
BD_SERVER=localhost,1433
BD_NAME=Refaccionaria
BD_USER=refaccionaria_app
BD_PASSWORD=escribe-aqui-la-contrasena-de-refaccionaria_app

TOKEN_SECRETO=escribe-aqui-tu-token-secreto

# La conexión a SQL Server siempre va cifrada. "si" = aceptar el certificado
# de SQL Server sin revisar quién lo firmó (lo normal en tu computadora, con
# SQL Server en Docker). En producción pon "no" si tu servidor tiene un
# certificado válido; si no se pone, con ENTORNO=produccion se usa "no".
BD_CONFIAR_CERTIFICADO=si
